{
  "name": "privatus/shopware-privatus-analytics",
  "description": "Adds the cookieless Privatus Analytics script to your Shopware 6 storefront and counts add to cart, checkout and purchases.",
  "type": "shopware-platform-plugin",
  "version": "1.0.0",
  "license": "MIT",
  "keywords": ["shopware", "shopware-plugin", "analytics", "privacy", "cookieless", "gdpr"],
  "homepage": "https://privatusanalytics.com",
  "support": {
    "email": "hello@privatusanalytics.com",
    "docs": "https://github.com/Privatus-Analytics/shopware#readme",
    "issues": "https://github.com/Privatus-Analytics/shopware/issues",
    "source": "https://github.com/Privatus-Analytics/shopware"
  },
  "authors": [
    {
      "name": "Privatus Analytics",
      "email": "hello@privatusanalytics.com",
      "homepage": "https://privatusanalytics.com"
    }
  ],
  "require": {
    "shopware/core": "~6.6.0 || ~6.7.0",
    "shopware/storefront": "~6.6.0 || ~6.7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "PrivatusAnalytics\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PrivatusAnalytics\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true,
      "php-http/discovery": true
    }
  },
  "extra": {
    "shopware-plugin-class": "PrivatusAnalytics\\PrivatusAnalytics",
    "plugin-icon": "src/Resources/config/plugin.png",
    "copyright": "(c) Two Phase LLC",
    "label": {
      "en-GB": "Privatus Analytics: cookieless analytics",
      "de-DE": "Privatus Analytics: Analyse ohne Cookies"
    },
    "description": {
      "en-GB": "See real visitors, add to carts and sales without cookies. Bots are filtered out.",
      "de-DE": "Sehen Sie echte Besucher, Warenkörbe und Verkäufe ohne Cookies. Bots werden herausgefiltert."
    },
    "manufacturerLink": {
      "en-GB": "https://privatusanalytics.com",
      "de-DE": "https://privatusanalytics.com"
    },
    "supportLink": {
      "en-GB": "https://github.com/Privatus-Analytics/shopware/issues",
      "de-DE": "https://github.com/Privatus-Analytics/shopware/issues"
    }
  }
}
